{
  "name": "client",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint app scripts tests *.js *.mjs",
    "lint:all": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write --no-error-on-unmatched-pattern \"app/**/*.{vue,js,css}\" \"scripts/**/*.mjs\" \"tests/**/*.js\" \"*.{js,mjs,json,md}\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"app/**/*.{vue,js,css}\" \"scripts/**/*.mjs\" \"tests/**/*.js\" \"*.{js,mjs,json,md}\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:tokens:update": "node scripts/check-tokens.mjs --update-baseline",
    "cap:sync": "npm run generate && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@nuxtjs/device": "^4.0.0",
    "@pinia/nuxt": "^0.11.3",
    "@vueuse/nuxt": "^15.0.0",
    "konsta": "^5.0.6",
    "material-icons": "^1.13.14",
    "nuxt": "^4.3.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.28",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.1.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@tailwindcss/vite": "^4.1.18",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.18",
    "vitest": "^5.0.5"
  }
}
