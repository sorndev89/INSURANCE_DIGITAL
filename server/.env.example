NODE_ENV=development
PORT=5055

# Database (MySQL via docker-compose.dev.yml)
DATABASE_URL=mysql://saiyfon:saiyfon@127.0.0.1:3315/saiyfon_insurance

# Auth (use different secrets per realm in production)
JWT_SECRET=change-me-tenant-secret
PLATFORM_JWT_SECRET=change-me-platform-secret

# Cache (Redis via docker-compose.dev.yml; empty = in-memory fallback)
REDIS_URL=redis://127.0.0.1:6390

# Domains
ROOT_DOMAIN=saiyfon.app
ADMIN_HOST=admin.saiyfon.app
CNAME_TARGET=cname.saiyfon.app
CORS_EXTRA_ORIGINS=http://localhost:3000,http://localhost:3001

# Internal TLS ask endpoint (shared with the reverse proxy)
TLS_ASK_TOKEN=change-me

# Runtime
# Legacy flag: maps to DB_DOCTOR_MODE=repair when DB_DOCTOR_MODE is not set.
RUN_MIGRATIONS_ON_START=false

# DB Doctor (runs before server.listen on every deploy)
# off | report | check | repair
# blank = repair in production, off in development
DB_DOCTOR_MODE=
DB_DOCTOR_FAIL_ON=critical
# false | true | deep
DB_DOCTOR_DATA_CHECKS=true
DB_DOCTOR_LOCK_TIMEOUT_MS=45000
DB_DOCTOR_DATA_BUDGET_MS=15000
DB_DOCTOR_AUDIT=true
TRUST_PROXY=1

# Admin UI served by the API (optional path to a generated admin build)
# ADMIN_DIST_PATH=../admin/.output/public

# Bootstrap (used by npm run seed:platform / seed:tenant)
PLATFORM_ADMIN_EMAIL=platform@saiyfon.com
PLATFORM_ADMIN_USERNAME=platform
PLATFORM_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_TENANT_SLUG=saiyfon
DEFAULT_TENANT_NAME=ສາຍຝົນ ປະກັນໄພ
DEFAULT_TENANT_PLAN=pro

DEFAULT_TENANT_ADMIN_EMAIL=admin@saiyfon.com
DEFAULT_TENANT_ADMIN_PASSWORD=Demo@1234
