{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check:static": "tsx src/scripts/db-static-check.ts",
    "db:doctor": "tsx src/scripts/db-doctor.ts",
    "db:doctor:repair": "tsx src/scripts/db-doctor.ts --mode repair",
    "db:doctor:deep": "tsx src/scripts/db-doctor.ts --deep",
    "seed": "tsx src/scripts/seed-initial.ts",
    "seed:all": "npm run seed:platform && npm run seed:tenant && npm run seed:demo",
    "seed:platform": "tsx src/scripts/seed-platform.ts",
    "seed:tenant": "tsx src/scripts/seed-tenant.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "test": "tsx --test src/utils/auth.test.ts src/utils/validate.test.ts src/middleware/cors.test.ts src/db/doctor/migrations.test.ts src/db/doctor/schema-snapshot.test.ts src/db/doctor/static-check.test.ts src/db/doctor/types.test.ts",
    "ui:build": "cd ../admin && NUXT_PUBLIC_API_BASE=/api npm run generate",
    "predev": "node scripts/check-port.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.17.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.3",
    "drizzle-kit": "^0.31.9",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
